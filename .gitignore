# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/
build/
*.egg

# Raw scan images — large binary files, not meant for git.
# cases.csv / manifest.csv (small metadata) ARE tracked; only the PNGs
# (and any raw .img files, if you keep those alongside) are excluded.
data/raw/cancerous/*
data/raw/noncancerous/*
!data/raw/cancerous/.gitkeep
!data/raw/noncancerous/.gitkeep
data/raw/**/*.img

# Checkpoints and training outputs — large, regenerable via train.py.
runs/
checkpoints/
logs/
*.pt
*.pth

# Aggregated results — regenerable via collect_results.py / plot_epoch_roc.py.
results/

# Caches
.matplotlib/
.hf_token
.ipynb_checkpoints/

# IDE / OS
.idea/
.vscode/
.DS_Store
